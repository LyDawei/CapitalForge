{
  "name": "capitalforge",
  "version": "2.0.0",
  "description": "AI-powered swing trading system (monorepo: engine, api, ui, shared)",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/shared",
    "packages/engine",
    "packages/api",
    "packages/ui"
  ],
  "scripts": {
    "build": "turbo run build --filter=@capitalforge/*",
    "test": "turbo run test --filter=@capitalforge/*",
    "dev": "turbo run dev --parallel --filter=@capitalforge/*",
    "lint": "turbo run lint --filter=@capitalforge/*",
    "prisma:generate": "npm run prisma:generate -w @capitalforge/engine",
    "prisma:migrate": "npm run prisma:migrate -w @capitalforge/engine",
    "prisma:studio": "npm run prisma:studio -w @capitalforge/engine",
    "run-cycle": "npm run run-cycle -w @capitalforge/engine",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build --no-cache"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
