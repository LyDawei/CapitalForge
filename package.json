{
  "name": "capitalforge",
  "version": "1.0.0",
  "description": "AI-powered swing trading system",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "docker:compose:up": "docker compose up -d",
    "docker:compose:down": "docker compose down",
    "docker:compose:build": "docker compose build --no-cache",

    "dev": "ts-node src/index.ts",
    "start": "node dist/src/index.js",
    "run-cycle": "ts-node scripts/runCycle.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --url postgresql://capitalforge:capitalforge@capitalforge-db:5432/capitalforge?schema=public",
    "prisma:studio": "prisma studio --url postgresql://capitalforge:capitalforge@capitalforge-db:5432/capitalforge?schema=public",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "technicalindicators": "^3.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "jest": "^29.7.0",
    "prisma": "^7.3.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
