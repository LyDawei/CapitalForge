generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model DailyCycle {
  id            String   @id @default(uuid())
  date          String // YYYY-MM-DD
  symbol        String
  technicalData Json // RSI, SMA20, SMA50, MACD, volume, avgVolume, close
  status        String // pending | completed | failed
  engineVersion String   @default("v1") // v1 | v2 — distinguishes which child rows to expect
  createdAt     DateTime @default(now())

  // V1 children
  evaluations AgentEvaluation[]
  decision    AggregatedDecision?
  trade       Trade?

  // V2 children
  specialistAnalyses SpecialistAnalysis[]
  deliberation       Deliberation?
  tradePlan          TradePlan?

  @@unique([date, symbol])
}

model AgentEvaluation {
  id            String   @id @default(uuid())
  cycleId       String
  agentName     String // momentum | meanReversion | confirmation
  promptVersion String
  bullishScore  Float // -1 to +1
  confidence    Float // 0 to 1
  rationale     String[] // Array of reason strings
  rawResponse   String // Full LLM response for debugging
  createdAt     DateTime @default(now())

  cycle DailyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
}

model AggregatedDecision {
  id            String   @id @default(uuid())
  cycleId       String   @unique
  weightedScore Float
  decision      String // BUY | SELL | HOLD
  riskBlocked   Boolean  @default(false)
  riskReason    String?
  createdAt     DateTime @default(now())

  cycle DailyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model Trade {
  id            String    @id @default(uuid())
  cycleId       String    @unique
  alpacaOrderId String
  side          String // buy | sell
  symbol        String
  quantity      Float
  filledPrice   Float?
  status        String // pending | filled | failed
  createdAt     DateTime  @default(now())
  filledAt      DateTime?

  cycle DailyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model SandboxState {
  id               String   @id @default(uuid())
  date             String
  allocatedCapital Float // Fixed sandbox allocation (e.g., 2000)
  currentEquity    Float // Current value of sandbox
  peakEquity       Float // Highest equity ever reached (for drawdown calc)
  cashBalance      Float
  positionQty      Float    @default(0)
  positionSymbol   String?
  positionAvgPrice Float?
  drawdownPct      Float    @default(0) // Calculated: (peakEquity - currentEquity) / peakEquity
  createdAt        DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model PromptVersion {
  id        String   @id @default(uuid())
  agentName String
  version   String
  template  String
  createdAt DateTime @default(now())

  @@unique([agentName, version])
}

// ============================================================================
// V2 ENGINE TABLES
// Additive — V1 cycles never write to these; V2 cycles populate them instead
// of (or alongside) AgentEvaluation / AggregatedDecision.
// ============================================================================

model SpecialistAnalysis {
  id             String   @id @default(uuid())
  cycleId        String
  specialistName String // trendRegime | setupPattern | momentum | meanReversion | volumeFlow | newsEvents
  promptVersion  String
  bullishScore   Float // -1 to +1
  confidence     Float // 0 to 1
  rationale      String[]
  flags          String[] // structured tags (overbought, breakout, pullback, ...)
  keyLevels      Json? // { support: number | null, resistance: number | null }
  extras         Json? // specialist-specific structured fields (regime, setupName, momentumState, ...)
  rawResponse    String // full LLM response for audit
  createdAt      DateTime @default(now())

  cycle DailyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@index([specialistName, createdAt])
}

model Deliberation {
  id             String   @id @default(uuid())
  cycleId        String   @unique
  symbol         String
  rounds         Int // number of head-trader LLM rounds
  finalAction    String // BUY | SELL | HOLD | CLOSE
  conviction     Float // 0 to 1
  totalLatencyMs Int
  totalTokens    Int?
  modelName      String
  promptVersion  String
  reasoningTrace Json // array of { round, thought, toolUsed }
  createdAt      DateTime @default(now())

  cycle     DailyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([cycleId])
}

model ToolCall {
  id             String   @id @default(uuid())
  deliberationId String
  round          Int
  toolName       String
  args           Json
  result         Json
  latencyMs      Int
  errored        Boolean  @default(false)
  errorMessage   String?
  createdAt      DateTime @default(now())

  deliberation Deliberation @relation(fields: [deliberationId], references: [id], onDelete: Cascade)

  @@index([deliberationId, round])
  @@index([toolName])
}

model TradePlan {
  id                   String    @id @default(uuid())
  cycleId              String    @unique
  symbol               String
  action               String // BUY | SELL | HOLD | CLOSE
  setupName            String?
  entry                Float
  stop                 Float?
  target1              Float?
  target2              Float?
  riskPctOfEquity      Float // capped at 0.02
  riskDollars          Float
  shares               Float
  conviction           Float
  timeStopBars         Int?
  invalidationCriteria String[]
  status               String // proposed | active | closed | cancelled | invalidated
  closeReason          String? // stop_hit | target_hit | time_stop | regime_change | manual
  closedAt             DateTime?
  realizedPnl          Float?
  createdAt            DateTime  @default(now())

  cycle DailyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([symbol, status])
  @@index([status])
}

model SectorMap {
  symbol   String  @id
  sector   String
  industry String?

  @@index([sector])
}

// ============================================================================
// Agent improvement notes — user-written observations attached to a specific
// agent (V1 or V2) and optionally to a specific cycle.
// ============================================================================

model AgentNote {
  id            String   @id @default(uuid())
  agentName     String
  engineVersion String // v1 | v2
  body          String
  cycleId       String?
  author        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agentName, engineVersion])
  @@index([cycleId])
  @@index([createdAt])
}

// ============================================================================
// Wallet allocation ledger — append-only history of how much capital is
// allocated to the agents. Each row records the new TOTAL plus the DELTA vs the
// previous row. Initial row is seeded from ALLOCATED_CAPITAL env var or via API.
// Subsequent changes only ever ADD/REMOVE the delta to/from cashBalance — they
// never reset the wallet. See packages/engine/src/v2/engine/walletAllocation.ts.
// ============================================================================

model WalletAllocation {
  id               String   @id @default(uuid())
  allocatedCapital Float // new total allocation after this change
  delta            Float // newTotal − previousTotal (positive = deposit, negative = withdraw)
  reason           String?
  author           String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// Risk & strategy config — append-only ledger of tunable knobs the agents
// respect at runtime. Latest row is the active config. Defaults match the
// hard-coded V2 baseline so an empty table still works.
// ============================================================================

model RiskConfig {
  id                     String   @id @default(uuid())
  // Risk sizing
  riskTolerancePct       Float    @default(1.0)  // multiplier on every emitted risk %; 0.7 = "be 30% less aggressive"
  maxRiskPctPerTrade     Float    @default(0.02) // hard cap on single-trade risk
  maxConcurrentPositions Int      @default(3)
  // Drawdown ladder (each = drawdown fraction at which the rule kicks in)
  drawdownHalveAt        Float    @default(0.10)
  drawdownCloseOnlyAt    Float    @default(0.15)
  drawdownHardHaltAt     Float    @default(0.20)
  // Target & stop defaults (used by mock head trader and as fallbacks)
  defaultStopLossPct     Float    @default(0.05) // distance below entry as % when LLM doesn't supply
  defaultTarget1R        Float    @default(1.6)  // R-multiple for target1
  defaultTarget2R        Float    @default(3.2)  // R-multiple for target2
  defaultTimeStopBars    Int      @default(10)
  // Audit
  reason    String?
  author    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
