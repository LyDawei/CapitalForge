# Database
DATABASE_URL="postgresql://capitalforge:capitalforge@capitalforge-db:5432/capitalforge?schema=public"

# Alpaca API (Paper Trading)
ALPACA_API_KEY="your_alpaca_api_key"
ALPACA_API_SECRET="your_alpaca_api_secret"
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# OpenAI API
OPENAI_API_KEY="your_openai_api_key"

# Trading Configuration
# Use TRADING_SYMBOLS for multiple symbols (comma-separated)
# Example: TRADING_SYMBOLS="SPY,QQQ,TSLA"
TRADING_SYMBOLS="SPY"
# Legacy: TRADING_SYMBOL is still supported for backward compatibility
# TRADING_SYMBOL="SPY"
ALLOCATED_CAPITAL=2000
POSITION_SIZE_PCT=0.2
MAX_DRAWDOWN_PCT=0.2

# LLM Configuration
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.2

# Scheduler (cron expression for daily run - 9:35 AM ET on weekdays)
CRON_SCHEDULE="35 9 * * 1-5"

# Mode: 'mock' for testing, 'paper' for paper trading
MODE="mock"
