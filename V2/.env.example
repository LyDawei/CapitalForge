# Postgres (point at any Postgres 14+; V2 owns its own tables under a separate schema)
DATABASE_URL="postgresql://capitalforge:capitalforge@localhost:5432/capitalforge_v2?schema=public"

# Backend
PORT=4000
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:4001"

# Frontend (Vite reads VITE_* at build time)
VITE_API_BASE_URL="http://localhost:4000"

# Alpaca (paper trading — reuses V1 keys)
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_DATA_URL="https://data.alpaca.markets"

# LLM provider — "openai" | "anthropic" | "mock"
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Run mode — "mock" keeps everything deterministic for local dev, no API keys needed
MODE="mock"
