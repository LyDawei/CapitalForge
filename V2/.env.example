# Postgres — defaults match docker-compose.yml (postgres/postgres, db capitalforge_v2,
# container owns host port 5432). Run `docker compose up -d` to start it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/capitalforge_v2?schema=public"

# Backend
PORT=4000
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:4001"

# Frontend (Vite reads VITE_* at build time)
VITE_API_BASE_URL="http://localhost:4000"

# ============================================================================
# Alpaca — market data + (eventually) order execution. Free tier is enough for
# everything V2 reads today: bars, quotes, news, asset metadata.
# Sign up: https://alpaca.markets/  (paper trading account, no funding required)
# ============================================================================
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_DATA_URL="https://data.alpaca.markets"
ALPACA_DATA_FEED="iex"             # 'iex' free, 'sip' paid
ALPACA_RATE_LIMIT_PER_MIN=180      # token bucket, free tier is 200/min

# ============================================================================
# FRED — Federal Reserve Economic Data. Free, registration only.
# Powers macroContext: 10Y yield (DGS10), VIX (VIXCLS), broad dollar (DTWEXBGS).
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
# ============================================================================
FRED_API_KEY=""

# ============================================================================
# Finnhub — earnings calendar, company news with sentiment, US macro calendar.
# Free tier is 60 req/min; we cap at 50 to leave headroom.
# Sign up: https://finnhub.io/dashboard
# ============================================================================
FINNHUB_API_KEY=""
FINNHUB_RATE_LIMIT_PER_MIN=50

# ============================================================================
# LLM provider — "openai" | "anthropic" | "mock"
#
# Set LLM_PROVIDER=openai and provide OPENAI_API_KEY to flip the system from
# mock to real LLM calls. Missing key silently falls back to mock so the dev
# loop never blocks.
#
# Two-tier model selection (cost optimization):
#   LLM_MODEL            → head trader (synthesis step, premium tier)
#   LLM_MODEL_SPECIALIST → 8 specialists + 2 audit agents + critic (pattern
#                          recognition + post-hoc analysis, cheaper tier)
#
# Approximate cost per cycle on the default split (gpt-4o + gpt-4o-mini):
#   ~$0.05–$0.07 per cycle (12 LLM calls)
# 90-day × 6-symbol backfill (~540 cycles) ≈ $30–$40 total.
# Ongoing daily ops (6 cycles/day) ≈ $0.30–$0.40 per day.
# ============================================================================
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o"                 # head trader tier
LLM_MODEL_SPECIALIST="gpt-4o-mini" # specialist + audit + critic tier
LLM_TEMPERATURE=0.2
LLM_RATE_LIMIT_PER_MIN=300         # token bucket for OpenAI calls
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""               # adapter not yet implemented; reserved

# Run mode — "mock" keeps everything deterministic for local dev, no API keys needed
MODE="mock"
