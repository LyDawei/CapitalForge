{
  "name": "capitalforge-v2",
  "version": "0.1.0",
  "description": "CapitalForge V2 — Agent Audit Console",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm run dev -w @cf2/backend",
    "dev:frontend": "npm run dev -w @cf2/frontend",
    "build": "npm run build -w @cf2/backend && npm run build -w @cf2/frontend",
    "test": "npm test -w @cf2/backend",
    "prisma:migrate": "npm run prisma:migrate -w @cf2/backend",
    "prisma:generate": "npm run prisma:generate -w @cf2/backend",
    "prisma:studio": "npm run prisma:studio -w @cf2/backend",
    "prisma:seed": "npm run prisma:seed -w @cf2/backend",
    "run-cycle": "npm run run-cycle -w @cf2/backend",
    "seed-cycles": "npm run seed-cycles -w @cf2/backend"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
