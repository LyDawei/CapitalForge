// CapitalForge V2 — Agent Audit Console
//
// Audit-first schema: every LLM invocation is recorded as an `AgentRun` with
// inputs, outputs, prompt version, model, latency, tokens, cost, and
// schema-validity. Domain tables (SpecialistAnalysis, TradePlan, etc.) reference
// an AgentRun so you can always trace a decision back to the exact LLM call that
// produced it.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Agent registry — one row per logical agent in the system.
// ============================================================================

enum AgentKind {
  specialist
  head_trader
  risk_auditor
  devils_advocate
  critic
}

model Agent {
  id            String    @id @default(uuid())
  /// Stable machine name (e.g. "trendRegime", "headTrader"). Used everywhere.
  name          String    @unique
  displayName   String
  kind          AgentKind
  role          String
  description   String
  /// JSON metadata: inputs[], flags[], extras[]. Mirrors shared/registry.ts shape.
  metadata      Json
  /// FK helper to the current default prompt version. Backend sets this on insert.
  activePromptVersionId String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  promptVersions PromptVersion[]
  runs           AgentRun[]
  metrics        AgentMetricSnapshot[]
  notes          AgentNote[]

  @@index([kind])
}

// ============================================================================
// BasePromptVersion — shared discipline/framework instructions prepended (as a
// system prompt) to EVERY agent's role-specific prompt. Versioned independently
// so you can change "how the agents should think" without touching individual
// agent prompts. Only one row is `isActive: true` at any time.
// ============================================================================

model BasePromptVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  template    String   @db.Text
  changelog   String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  runs AgentRun[]

  @@index([isActive])
  @@index([createdAt])
}

// ============================================================================
// Prompt versioning — every prompt template is stored, never overwritten.
// ============================================================================

model PromptVersion {
  id          String   @id @default(uuid())
  agentId     String
  /// Semver-ish: "0.1.0", "0.2.0-rc1", etc.
  version     String
  /// User-editable role/persona/discipline instructions. The runner concatenates
  /// this with `outputContract` at render time. Splitting these two halves makes
  /// it structurally impossible to silently break the runner by renaming an
  /// output field in a prompt edit.
  directiveTemplate String @db.Text
  /// Auto-included canonical "REQUIRED OUTPUT — JSON only: { ... }" block.
  /// Always derived from the agent's Zod schema in `backend/src/schemas/agent-outputs.ts`.
  /// Persisted per-version so historical runs can be replayed against the exact
  /// contract they were sent.
  outputContract    String @db.Text
  /// Human-readable note: what changed and why.
  changelog   String?
  /// Optional sampling config snapshot baked into this version.
  modelName   String?
  temperature Float?
  isActive    Boolean  @default(false)
  /// Shadow A/B: when true, the cycle runner ALSO renders this version each
  /// cycle (alongside the active one) and persists its AgentRun with
  /// runKind='ab'. Only one candidate per agent at a time — enforced in app
  /// code, not the DB. Shadow TradePlans are persisted but never executed;
  /// the counterfactual settler walks them forward for hit-rate comparison.
  isShadowCandidate Boolean @default(false)
  createdAt   DateTime @default(now())

  agent Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs  AgentRun[]

  @@unique([agentId, version])
  @@index([agentId, createdAt])
  @@index([isShadowCandidate])
}

// ============================================================================
// Cycle — one row per (date, symbol). Aggregates all the agent activity for that
// symbol on that day.
// ============================================================================

enum CycleStatus {
  pending
  running
  completed
  failed
}

model Cycle {
  id           String      @id @default(uuid())
  date         String       // YYYY-MM-DD
  symbol       String
  /// Snapshotted technicals at cycle time: close, rsi, sma20, sma50, macdHistogram, volume, avgVolume.
  technicals   Json
  /// Snapshotted regime/setup metadata once trendRegime + setupPattern run.
  marketContext Json?
  status       CycleStatus  @default(pending)
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  /// Total wall time for the cycle in ms.
  totalLatencyMs Int?
  /// Total cost in USD across all agent runs in this cycle.
  totalCostUsd Float?

  runs                AgentRun[]
  specialistAnalyses  SpecialistAnalysis[]
  tradePlan           TradePlan?
  deliberation        Deliberation?
  critiques           Critique[]
  anomalies           Anomaly[]

  @@unique([date, symbol])
  @@index([date])
  @@index([symbol, date])
  @@index([status])
}

// ============================================================================
// AgentRun — the audit primitive. ONE ROW PER LLM INVOCATION.
// Every domain row (SpecialistAnalysis, TradePlan proposal, ToolCall result)
// references an AgentRun so the chain of custody is unbroken.
// ============================================================================

model AgentRun {
  id                  String   @id @default(uuid())
  agentId             String
  promptVersionId     String
  /// Active base-prompt version at the time of this run. Nullable for backwards
  /// compat with runs created before the base prompt was introduced.
  basePromptVersionId String?
  cycleId             String?
  /// SHA-256 of the rendered prompt — used for replay & stability checks.
  inputHash       String
  /// The fully rendered prompt as sent to the LLM.
  renderedPrompt  String   @db.Text
  /// Structured input snapshot (technicals, sandbox state, specialist outputs...).
  inputPayload    Json
  /// Provider + model that served this call.
  provider        String    // "openai" | "anthropic" | "mock"
  modelName       String
  temperature     Float
  /// Raw response text from the LLM.
  rawResponse     String   @db.Text
  /// Zod-parsed output if validation succeeded.
  parsedOutput    Json?
  schemaValid     Boolean  @default(false)
  /// Parse / validation error message if !schemaValid.
  parseError      String?
  /// Observability.
  latencyMs       Int
  tokensIn        Int?
  tokensOut       Int?
  costUsd         Float?
  /// "primary" for the main run, "replay" for stability replays, "ab" for prompt A/B.
  runKind         String   @default("primary")
  createdAt       DateTime @default(now())

  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  promptVersion     PromptVersion      @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  basePromptVersion BasePromptVersion? @relation(fields: [basePromptVersionId], references: [id], onDelete: SetNull)
  cycle             Cycle?             @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  specialistAnalysis SpecialistAnalysis?
  tradePlan          TradePlan?
  toolCalls          ToolCall[]
  critique           Critique?

  @@index([agentId, createdAt])
  @@index([cycleId])
  @@index([promptVersionId])
  @@index([basePromptVersionId])
  @@index([inputHash])
  @@index([schemaValid])
  @@index([runKind])
}

// ============================================================================
// SpecialistAnalysis — domain output of one specialist run within a cycle.
// ============================================================================

model SpecialistAnalysis {
  id            String   @id @default(uuid())
  cycleId       String
  agentRunId    String   @unique
  /// Mirrors agent.name for fast filtering without a join.
  agentName     String
  bullishScore  Float    // -1..+1
  confidence    Float    // 0..1
  rationale     String[]
  flags         String[]
  /// { support: number | null, resistance: number | null }
  keyLevels     Json?
  /// Specialist-specific structured fields (regime, setupName, momentumState, ...).
  extras        Json?
  createdAt     DateTime @default(now())

  cycle    Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@index([agentName, createdAt])
}

// ============================================================================
// Deliberation — head trader's reasoning trace for a cycle. References many
// AgentRuns (one per tool-using round).
// ============================================================================

enum TradeAction {
  BUY
  SELL
  HOLD
  CLOSE
}

model Deliberation {
  id              String   @id @default(uuid())
  cycleId         String   @unique
  rounds          Int
  finalAction     TradeAction
  conviction      Float    // 0..1
  totalLatencyMs  Int
  totalTokens     Int?
  totalCostUsd    Float?
  modelName       String
  /// Array of { round, thought, toolUsed, agentRunId } — the audit trail.
  reasoningTrace  Json
  createdAt       DateTime @default(now())

  cycle Cycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

// ============================================================================
// ToolCall — tool invocations made by tool-using agents (head trader, etc).
// ============================================================================

model ToolCall {
  id           String   @id @default(uuid())
  agentRunId   String
  round        Int
  toolName     String
  args         Json
  result       Json
  latencyMs    Int
  errored      Boolean  @default(false)
  errorMessage String?
  /// Optional: did this tool result *change* the action vs the no-tool baseline?
  influenceTag String?   // "changed_action" | "tightened_stop" | "no_op" | null
  createdAt    DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, round])
  @@index([toolName])
}

// ============================================================================
// TradePlan — head trader's emitted plan for a cycle.
// ============================================================================

enum TradePlanStatus {
  proposed
  active
  closed
  cancelled
  invalidated
}

enum CloseReason {
  stop_hit
  target_hit
  target1_hit
  target2_hit
  time_stop
  regime_change
  manual
  invalidated
}

model TradePlan {
  id                   String           @id @default(uuid())
  cycleId              String           @unique
  agentRunId           String           @unique
  symbol               String
  action               TradeAction
  setupName            String?
  entry                Float
  stop                 Float?
  target1              Float?
  target2              Float?
  riskPctOfEquity      Float
  riskDollars          Float
  shares               Float
  conviction           Float
  timeStopBars         Int?
  invalidationCriteria String[]
  status               TradePlanStatus  @default(proposed)
  closeReason          CloseReason?
  closedAt             DateTime?
  realizedPnl          Float?
  /// Number of bars actually held (only set on close).
  heldBars             Int?
  createdAt            DateTime         @default(now())

  cycle    Cycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  agentRun AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  outcome  TradeOutcome?
  critiques Critique[]

  @@index([symbol, status])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// TradeOutcome — settled result. Decoupled from TradePlan so we can compute
// outcome metrics (R-multiple, MFE/MAE) without bloating the plan row.
// ============================================================================

model TradeOutcome {
  id            String      @id @default(uuid())
  tradePlanId   String      @unique
  closeReason   CloseReason
  realizedPnl   Float
  /// R-multiple: (exit - entry) / (entry - stop) for longs.
  rMultiple     Float?
  /// Max favorable excursion in $ from entry over the holding period.
  mfe           Float?
  /// Max adverse excursion (worst drawdown intra-trade) in $.
  mae           Float?
  heldBars      Int
  closedAt      DateTime    @default(now())

  tradePlan TradePlan @relation(fields: [tradePlanId], references: [id], onDelete: Cascade)

  @@index([closedAt])
  @@index([closeReason])
}

// ============================================================================
// Critique — written by the `critic` agent post-cycle (or by a human reviewer).
// Anchored to the cycle, optionally to a trade plan or a specific agent run.
// ============================================================================

enum Severity {
  info
  warn
  error
}

model Critique {
  id          String   @id @default(uuid())
  cycleId     String?
  agentRunId  String?  @unique
  tradePlanId String?
  /// "critic" | "human" | name of the specific agent that wrote this.
  author      String
  severity    Severity @default(info)
  body        String   @db.Text
  /// Optional structured tags ("missed_overbought", "stop_too_tight", ...).
  tags        String[]
  createdAt   DateTime @default(now())

  cycle     Cycle?     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  agentRun  AgentRun?  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  tradePlan TradePlan? @relation(fields: [tradePlanId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@index([author, createdAt])
  @@index([severity])
}

// ============================================================================
// Anomaly — auto-detected oddities. UI highlights these prominently.
// ============================================================================

enum AnomalyKind {
  schema_failure
  latency_spike
  cost_spike
  output_drift
  confidence_outlier
  unanimous_disagreement
  hit_rate_drop
  stability_low
}

model Anomaly {
  id          String      @id @default(uuid())
  kind        AnomalyKind
  severity    Severity    @default(warn)
  agentId     String?
  cycleId     String?
  /// Free-form details — JSON for query, body for human read.
  detail      Json
  body        String      @db.Text
  /// Set when an operator acks the anomaly.
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt   DateTime    @default(now())

  cycle Cycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([severity])
  @@index([acknowledgedAt])
}

// ============================================================================
// AgentMetricSnapshot — pre-computed rolling metrics per agent per window.
// The audit job writes these so the UI doesn't recompute on every load.
// ============================================================================

model AgentMetricSnapshot {
  id              String   @id @default(uuid())
  agentId         String
  /// "7d" | "30d" | "90d" | "all"
  window          String
  periodStart     DateTime
  periodEnd       DateTime
  sampleSize      Int
  /// Hit rate over closed trades influenced by this agent.
  hitRate         Float?
  /// Brier score for confidence calibration (lower = better).
  brierScore      Float?
  avgConfidence   Float?
  avgLatencyMs    Float?
  p95LatencyMs    Float?
  totalCostUsd    Float?
  schemaFailRate  Float?
  /// Variance across replay runs with identical inputs (0 = perfectly stable).
  stabilityScore  Float?
  /// Full snapshot payload for the UI to consume without recomputation.
  payload         Json?
  createdAt       DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, window, periodEnd])
  @@index([agentId, window])
}

// ============================================================================
// AgentNote — user-written observations attached to a specific agent.
// ============================================================================

model AgentNote {
  id        String   @id @default(uuid())
  agentId   String
  cycleId   String?
  author    String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([cycleId])
}

// ============================================================================
// SandboxState & RiskConfig — wallet ledger + tunable knobs (mirrors V1).
// ============================================================================

model SandboxState {
  id               String   @id @default(uuid())
  date             String
  allocatedCapital Float
  currentEquity    Float
  peakEquity       Float
  cashBalance      Float
  positionQty      Float    @default(0)
  positionSymbol   String?
  positionAvgPrice Float?
  drawdownPct      Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model RiskConfig {
  id                     String   @id @default(uuid())
  /// Name of the preset this row was created from, or "custom".
  presetName             String   @default("balanced")
  riskTolerancePct       Float    @default(1.0)
  maxRiskPctPerTrade     Float    @default(0.02)
  maxConcurrentPositions Int      @default(3)
  drawdownHalveAt        Float    @default(0.10)
  drawdownCloseOnlyAt    Float    @default(0.15)
  drawdownHardHaltAt     Float    @default(0.20)
  defaultStopLossPct     Float    @default(0.05)
  defaultTarget1R        Float    @default(1.6)
  defaultTarget2R        Float    @default(3.2)
  defaultTimeStopBars    Int      @default(10)
  reason                 String?
  author                 String?
  createdAt              DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// StrategyConfig — append-only ledger of strategy preferences. Independent of
// RiskConfig so you can change strategy bias without touching risk knobs.
// ============================================================================

enum StrategyBias {
  trend_following
  mean_reversion
  balanced
}

enum HoldingPeriod {
  short_term  // 1-3 days
  medium_term // 3-10 days
  long_term   // 10-30 days
}

model StrategyConfig {
  id                String        @id @default(uuid())
  presetName        String        @default("balanced")
  /// How the head trader should weight specialists.
  strategyBias      StrategyBias  @default(balanced)
  /// Preferred holding period — affects timeStopBars default.
  holdingPeriod     HoldingPeriod @default(medium_term)
  /// If true, head trader is instructed to HOLD when an earnings event is
  /// within `avoidEarningsWindowDays` days.
  avoidEarnings     Boolean       @default(true)
  avoidEarningsWindowDays Int     @default(3)
  /// Symbols watchlist — what the cycle runner iterates over.
  watchlist         String[]      @default(["SPY", "AAPL", "NVDA", "TSLA", "MSFT", "AMZN"])
  /// Allocated capital for the sandbox in USD.
  allocatedCapital  Float         @default(2000)
  reason            String?
  author            String?
  createdAt         DateTime      @default(now())

  @@index([createdAt])
}
